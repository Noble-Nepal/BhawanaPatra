@using MudBlazor
@inject NavigationManager Nav
@inject UserService Auth

<MudPaper Elevation="1" Square="true" Class="pa-3">
    <MudStack Row="true"
              Wrap="Wrap.Wrap"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween"
              Spacing="2">

       
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 260px;">
            <MudAvatar Size="Size.Medium" Square="true">
                <img src="notes.png"
                     alt="BhawanaPatra Logo"
                     style="width: 100%; height: 100%; object-fit: contain;" />
            </MudAvatar>

            <MudText Typo="Typo.h5" Style="font-weight:800; letter-spacing:-0.03em;">
                BhawanaPatra
            </MudText>
        </MudStack>

        
        <MudStack Row="true"
                  Wrap="Wrap.Wrap"
                  AlignItems="AlignItems.Center"
                  Spacing="1">

            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => Go("/home"))">
                Home
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => Go("/calendar"))">
                Calendar
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => Go("/entries"))">
                Entries
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => Go("/settings"))">
                Settings
            </MudButton>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

            <MudDivider Vertical="true" FlexItem="true" /> <MudIconButton Icon="@Icons.Material.Filled.LightMode" Color="Color.Dark" />

          
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           OnClick="Logout" />
        </MudStack>

    </MudStack>
</MudPaper>

<MudDivider />

@code {
    
    private bool _isDarkMode = false;

    private void Go(string route)
    {
        Nav.NavigateTo(route);
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;

     
    }

    private void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login");
    }
}
