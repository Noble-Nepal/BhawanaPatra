@page "/"
@page "/home"

@using BhawanaPatra.Components.Pages.Entries
@using MudBlazor
@using BhawanaPatra.Models
@inject UserService UserService
@inject BhawanaPatra.Service.EntryService EntryService
@inject BhawanaPatra.Service.MoodAnalyticsService MoodAnalyticsService
@inject BhawanaPatra.Service.StreakAnalyticsService StreakAnalyticsService
@inject NavigationManager Nav
@inject AppThemeService ThemeService
@inject AuthenticationStateService AuthState
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">

    @if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
    {
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:800;">
                Authentication required
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                Please login to access your dashboard.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/login"))">
                Go to login
            </MudButton>
        </MudPaper>
    }
    else
    {

        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:18px;">
            <MudStack Spacing="2">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Wrap="Wrap.Wrap">

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5" Style="font-weight:900;">
                            Today's Entry
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                        </MudText>
                    </MudStack>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Style="border-radius:12px;"
                               OnClick="@(()=>Nav.NavigateTo("/entry"))">
                        Open Editor
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-2" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:14px;">
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                Current Streak
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight:900;">
                                @CurrentStreak
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                days
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:14px;">
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                Longest Streak
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight:900;">
                                @LongestStreak
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                days
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:14px;">
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                Total Entries
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight:900;">
                                @TotalEntries
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                entries
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:14px;">
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                Words Today
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight:900;">
                                @WordsToday
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                words
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.Center" Class="mt-2">
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Large"
                                       Color="Color.Primary"
                                       Style="border-radius:14px; padding:12px 28px;"
                                       OnClick="@(()=>Nav.NavigateTo("/entry"))">
                                Write Today's Entry
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>

            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3" Class="mt-4">
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-6" Style="border-radius:18px; min-height:280px;">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:800;">
                        Mood Distribution
                    </MudText>
                    <MudDivider Class="my-3" />

                    @if (MoodCategoryStats.Values.Sum() == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            No mood data yet. Start tracking your moods in entries.
                        </MudText>
                    }
                    else
                    {
                        <MudChart ChartType="ChartType.Pie"
                                  InputData="@MoodChartData"
                                  InputLabels="@MoodChartLabels"
                                  Width="100%"
                                  Height="250px" />

                        <MudStack Spacing="1" Class="mt-3">
                            <MudText Typo="Typo.caption">
                                Positive: <strong>@MoodCategoryStats["Positive"]</strong> (@MoodPercentages["Positive"]%)
                            </MudText>
                            <MudText Typo="Typo.caption">
                                Neutral: <strong>@MoodCategoryStats["Neutral"]</strong> (@MoodPercentages["Neutral"]%)
                            </MudText>
                            <MudText Typo="Typo.caption">
                                Negative: <strong>@MoodCategoryStats["Negative"]</strong> (@MoodPercentages["Negative"]%)
                            </MudText>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-6" Style="border-radius:18px; min-height:280px;">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:800;">
                        Writing Stats
                    </MudText>
                    <MudDivider Class="my-3" />

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            This Month: <b>@MonthEntries</b>/<b>@DaysInMonth</b> days
                        </MudText>

                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            Total words (recent): <b>@RecentWords</b>
                        </MudText>

                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            Avg per entry (recent): <b>@AverageWords</b> words
                        </MudText>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                            Most productive day: <b>@MostProductiveDay</b>
                        </MudText>

                        @if (!string.IsNullOrEmpty(MostUsedTag) && MostUsedTag != "—")
                        {
                            <MudText Typo="Typo.body2" Color="Color.Inherit">
                                Most used tag: <b>@MostUsedTag</b>
                            </MudText>
                        }

                        @if (TopMoods.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                                <strong>Most Frequent Moods:</strong>
                            </MudText>
                            @foreach (var mood in TopMoods.Take(3))
                            {
                                <MudText Typo="Typo.caption">
                                    @mood.Key: <strong>@mood.Value</strong> times
                                </MudText>
                            }
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>


        <MudPaper Outlined="true" Class="pa-6 mt-4" Style="border-radius:18px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle1" Style="font-weight:800;">
                    Recent Entries
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Style="border-radius:12px;"
                           OnClick="@(()=>Nav.NavigateTo("/entries"))">
                    View all
                </MudButton>
            </MudStack>

            <MudDivider Class="my-3" />

            @if (RecentEntries.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Inherit">
                    No entries yet. Start by writing today's entry.
                </MudText>
            }
            else
            {
                <MudStack Spacing="2" Class="overflow-auto">
                    @foreach (var entry in RecentEntries)
                    {
                        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px; cursor: pointer;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                                <MudStack Spacing="1" Style="flex-grow: 1;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight:800;">
                                            @FormatDate(entry.EntryDateKey)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Inherit">
                                            @entry.WordCount words
                                        </MudText>
                                    </MudStack>

                                    @if (!string.IsNullOrWhiteSpace(entry.Title))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Inherit">
                                            @entry.Title
                                        </MudText>
                                    }

                                </MudStack>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ShowEntryDetails(entry))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteEntry(entry.EntryId))" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>

            }
        </MudPaper>
    }

</MudContainer>


@code {
    private int CurrentStreak;
    private int LongestStreak;
    private int TotalEntries;
    private int WordsToday;

    private int MonthEntries;
    private int DaysInMonth;
    private int RecentWords;
    private int AverageWords;

    private string MostProductiveDay = "—";
    private string MostUsedTag = "—";

    private List<EntryModel> RecentEntries = new();

    private Dictionary<string, int> MoodCategoryStats = new();
    private Dictionary<string, double> MoodPercentages = new();
    private Dictionary<string, int> TopMoods = new();
    private Dictionary<string, int> TopTags = new();

    private double[] MoodChartData = Array.Empty<double>();
    private string[] MoodChartLabels = Array.Empty<string>();

    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
            return;

        var userId = AuthState.CurrentUserId.Value;

        TotalEntries = EntryService.GetTotalEntries(userId);
        WordsToday = EntryService.GetWordsToday(userId);
        CurrentStreak = StreakAnalyticsService.GetCurrentStreak(userId);
        LongestStreak = StreakAnalyticsService.GetLongestStreak(userId);

        RecentEntries = EntryService.GetRecentEntries(userId, take: 5);

        DaysInMonth = DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month);

        MonthEntries = RecentEntries.Count(e =>
        {
            if (!DateTime.TryParse(e.EntryDateKey, out var dt)) return false;
            return dt.Year == DateTime.Now.Year && dt.Month == DateTime.Now.Month;
        });

        RecentWords = RecentEntries.Sum(e => e.WordCount);
        AverageWords = RecentEntries.Count == 0 ? 0 : (int)Math.Round((double)RecentWords / RecentEntries.Count);

        var best = RecentEntries.OrderByDescending(e => e.WordCount).FirstOrDefault();
        if (best != null)
            MostProductiveDay = FormatDate(best.EntryDateKey);

        MoodCategoryStats = MoodAnalyticsService.GetMoodCategoryStatistics(userId);
        MoodPercentages = MoodAnalyticsService.GetMoodCategoryPercentages(userId);
        TopMoods = MoodAnalyticsService.GetMoodFrequency(userId, 5);
        TopTags = MoodAnalyticsService.GetTagFrequency(userId, 10);

        if (TopTags.Count > 0)
            MostUsedTag = TopTags.First().Key;

        MoodChartData = new double[]
        {
            MoodCategoryStats["Positive"],
            MoodCategoryStats["Neutral"],
            MoodCategoryStats["Negative"]
        };
        MoodChartLabels = new string[] { "Positive", "Neutral", "Negative" };
    }

    private static string FormatDate(string dateKey)
        => DateTime.TryParse(dateKey, out var dt) ? dt.ToString("MMM d, yyyy") : dateKey;
    private void DeleteEntry(int entryId)
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        EntryService.DeleteEntry(entryId);

        var userId = AuthState.CurrentUserId.Value;
        RecentEntries = EntryService.GetRecentEntries(userId, take: 7);
        TotalEntries = EntryService.GetTotalEntries(userId);

        StateHasChanged();
    }
    private async Task ShowEntryDetails(EntryModel entry)
    {
        var parameters = new DialogParameters<EntryDetailsDialog>
    {
        { x => x.Entry, entry }
    };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<EntryDetailsDialog>("Entry Details", parameters, options);
    }
}