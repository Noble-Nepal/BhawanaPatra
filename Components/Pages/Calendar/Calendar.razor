@page "/calendar"
@using BhawanaPatra.Components.Pages.Entries
@using MudBlazor
@using BhawanaPatra.Models
@inject BhawanaPatra.Service.EntryService EntryService
@inject NavigationManager Nav
@inject AuthenticationStateService AuthState
@inject IDialogService DialogService


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">

    @if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
    {
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:800;">
                Authentication required
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                Please login to view your calendar.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/login"))">
                Go to login
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Spacing="0" Class="mb-4">
            <MudText Typo="Typo.h3" Style="font-weight:900;">
                Calendar View
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Inherit">
                Navigate through your journal entries by date
            </MudText>
        </MudStack>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px;">
                    <MudDatePicker @ref="_picker"
                                   Date="SelectedDate"
                                   PickerVariant="PickerVariant.Static"
                                   DateChanged="OnDateChanged"
                                   MaxDate="_maxDate">
                        <PickerActions>
                            <MudButton Class="mr-auto align-self-start" OnClick="TodayAsync">Today</MudButton>
                        </PickerActions>
                    </MudDatePicker>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px; min-height:400px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6" Style="font-weight:800;">
                            Entries for @(SelectedDate?.ToString("MMMM dd, yyyy") ?? "Selected Date")
                        </MudText>

                        <MudDivider />

                        @if (EntriesToday.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-4">
                                No entries for this date.
                            </MudText>
                          
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var entry in PagedEntriesToday)
                                {
                                    <MudPaper Outlined="true" Class="pa-3" Style="border-radius:12px; cursor: pointer;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudStack Spacing="1" Style="flex-grow: 1;">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight:800;">
                                                    @(string.IsNullOrWhiteSpace(entry.Title) ? "Untitled Entry" : entry.Title)
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Inherit">
                                                    @entry.CreatedAt.ToString("hh:mm tt") - @entry.WordCount words
                                                </MudText>
                                            </MudStack>

                                            <MudStack Row="true" Spacing="1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ShowEntryPopup(entry))" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => DeleteEntry(entry.EntryId))" />
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>

                            @if (TotalPages > 1)
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                   Disabled="@(CurrentPage == 1)"
                                                   OnClick="PreviousPage"
                                                   Size="Size.Small" />

                                    <MudText Typo="Typo.body2">
                                        Page @CurrentPage of @TotalPages
                                    </MudText>

                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                   Disabled="@(CurrentPage == TotalPages)"
                                                   OnClick="NextPage"
                                                   Size="Size.Small" />
                                </MudStack>
                            }
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

</MudContainer>

@code {
    private MudDatePicker _picker;
    private DateTime? SelectedDate = DateTime.Today;
    private DateTime _maxDate = DateTime.Today;

    private List<EntryModel> AllEntries = new();
    private int CurrentPage = 1;
    private int PageSize = 3;

    private int TotalPages => (int)Math.Ceiling((double)EntriesToday.Count / PageSize);

    private List<EntryModel> EntriesToday =>
        AllEntries
            .Where(e => SelectedDate.HasValue && 
                        DateTime.TryParse(e.EntryDateKey, out var entryDate) && 
                        entryDate.Date == SelectedDate.Value.Date)
            .OrderBy(e => e.CreatedAt.TimeOfDay)
            .ToList();

    private List<EntryModel> PagedEntriesToday =>
        EntriesToday
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
            return;

        var userId = AuthState.CurrentUserId.Value;
        AllEntries = EntryService.GetAllEntries(userId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _picker?.GoToDate();
        }
    }

    private void OnDateChanged(DateTime? newDate)
    {
        SelectedDate = newDate;
        CurrentPage = 1;
        StateHasChanged();
    }

    private Task TodayAsync()
    {
        SelectedDate = DateTime.Today;
        CurrentPage = 1;
        return _picker.GoToDate(DateTime.Today);
    }

    private void EditEntry(EntryModel entry)
    {
        Nav.NavigateTo("/entry");
    }

    private async Task ShowEntryPopup(EntryModel entry)
    {
        var parameters = new DialogParameters<EntryDetailsDialog>
        {
            { x => x.Entry, entry }
        };

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<EntryDetailsDialog>("Entry Details", parameters, options);
    }

    private void DeleteEntry(int entryId)
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        EntryService.DeleteEntry(entryId);

        var userId = AuthState.CurrentUserId.Value;
        AllEntries = EntryService.GetAllEntries(userId);
        CurrentPage = 1;

        StateHasChanged();
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }
}
