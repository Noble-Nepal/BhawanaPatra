@page "/entry"
@using BhawanaPatra.Components.Shared.Constants
@using MudBlazor
@using BhawanaPatra.Models
@inject QuilService quil
@inject IJSRuntime js
@inject BhawanaPatra.Service.EntryService EntryService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateService AuthState

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
    {
        <MudPaper Outlined="true" Class="pa-5" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:800;">
                Authentication required
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                Please login to write your journal.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/login"))">
                Go to login
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1" Style="font-weight:900;">
                    New Entry - @DateTime.Now.ToString("MMMM dd, yyyy")
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="border-radius:12px;"
                           OnClick="@(() => Nav.NavigateTo("/home"))">
                    Back
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-5 mt-4" Style="border-radius:16px;">
            <MudStack Spacing="3">

                <MudTextField Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Title" />

                <div style="display: flex; justify-content: center; margin: 16px 0;">
                    <MudImage Src="moods.png"
                              Alt="Decorative journal image"
                              Height="200"
                              ObjectFit="ObjectFit.Cover"
                              Style="border-radius:8px; max-width: 100%;" />
                </div>

                <MudPaper Outlined="true" Class="pa-4" Color="Color.Default" Style="border-radius:12px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:800;" Class="mb-3">
                        How are you feeling? <span style="color:red;">*</span>
                    </MudText>

                    <MudSelect T="string"
                               Label="Primary Mood"
                               Value="@SelectedPrimaryMood"
                               ValueChanged="@OnPrimaryMoodChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true">
                        <MudSelectItem Value="@string.Empty" Disabled="true">Select Primary Mood</MudSelectItem>

                        <MudSelectItem Value="@("--- Positive ---")" Disabled="true">
                            <MudText Color="Color.Success" Style="font-weight:600;">Positive</MudText>
                        </MudSelectItem>
                        @foreach (var mood in PositiveMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }

                        <MudSelectItem Value="@("--- Neutral ---")" Disabled="true">
                            <MudText Color="Color.Default" Style="font-weight:600;">Neutral</MudText>
                        </MudSelectItem>
                        @foreach (var mood in NeutralMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }

                        <MudSelectItem Value="@("--- Negative ---")" Disabled="true">
                            <MudText Color="Color.Error" Style="font-weight:600;">Negative</MudText>
                        </MudSelectItem>
                        @foreach (var mood in NegativeMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.body2" Class="mt-4 mb-2">
                        Secondary Moods (Optional, max 2)
                    </MudText>
                    <MudSelect T="string"
                               Label="Secondary Moods"
                               MultiSelection
                               SelectedValues="SelectedSecondaryMoods"
                               SelectedValuesChanged="OnSecondaryMoodsChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">

                        <MudSelectItem Value="@("--- Positive ---")" Disabled="true">
                            <MudText Color="Color.Success" Style="font-weight:600;">Positive</MudText>
                        </MudSelectItem>
                        @foreach (var mood in PositiveMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }

                        <MudSelectItem Value="@("--- Neutral ---")" Disabled="true">
                            <MudText Color="Color.Default" Style="font-weight:600;">Neutral</MudText>
                        </MudSelectItem>
                        @foreach (var mood in NeutralMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }

                        <MudSelectItem Value="@("--- Negative ---")" Disabled="true">
                            <MudText Color="Color.Error" Style="font-weight:600;">Negative</MudText>
                        </MudSelectItem>
                        @foreach (var mood in NegativeMoods)
                        {
                            <MudSelectItem Value="@mood">@mood</MudSelectItem>
                        }
                    </MudSelect>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4" Color="Color.Default" Style="border-radius:12px; ">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:800;" Class="mb-3">
                        Tags (Optional)
                    </MudText>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudTextField @bind-Value="NewTag"
                                      Label="Add custom tag"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Style="flex-grow: 1;"
                                      OnKeyDown="@(async (e) => { if (e.Key == "Enter") await Task.Run(() => AddCustomTag()); })" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddCustomTag"
                                   Style="border-radius:12px;">
                            Add
                        </MudButton>
                    </MudStack>

                    <MudText Typo="Typo.caption" Class="mb-2">Pre-defined Tags:</MudText>
                    <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                        @foreach (var tag in PredefinedTags)
                        {
                            <MudChip T="string"
                                     Text="@tag"
                                     Color="@(SelectedTags.Contains(tag) ? Color.Inherit : Color.Default)"
                                     Variant="@(SelectedTags.Contains(tag) ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => ToggleTag(tag))">
                                @tag
                            </MudChip>
                        }
                    </MudStack>

                    @if (CustomTags.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-3 mb-2">Custom Tags:</MudText>
                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                            @foreach (var tag in CustomTags)
                            {
                                <MudChip T="string"
                                         Text="@tag"
                                         Color="Color.Surface"
                                         OnClose="@(() => RemoveCustomTag(tag))">
                                    @tag
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudPaper>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:800;">Content</MudText>
                    <MudPaper Variant="Variant.Outlined">
                        <div id="quill-editor" style="height:300px;"></div>
                    </MudPaper>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    @if (TodayEntry == null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Default" Style="border-radius:12px;" OnClick="CreateEntry">
                            Save Entry
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Default" Style="border-radius:12px;" OnClick="UpdateEntry">
                            Update Entry
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="border-radius:12px;" OnClick="DeleteEntry" Disabled="@(TodayEntry == null)">
                        Delete Entry
                    </MudButton>
                </MudStack>

            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-5 mt-4" Style="border-radius:16px;">
            <MudText Typo="Typo.subtitle2" Style="font-weight:800;">Details</MudText>
            <MudDivider Class="my-3" />
            @if (TodayEntry == null)
            {
                <MudText Typo="Typo.body2">No entry saved yet for today.</MudText>
            }
            else
            {
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2">Created: @TodayEntry.CreatedAt.ToString("dd MMM yyyy, HH:mm")</MudText>
                    <MudText Typo="Typo.body2">Updated: @TodayEntry.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</MudText>
                    <MudText Typo="Typo.body2">Word count: @TodayEntry.WordCount</MudText>

                    @if (!string.IsNullOrEmpty(TodayEntry.PrimaryMood))
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.body2"><strong>Primary Mood:</strong> (@TodayEntry.MoodCategory)</MudText>
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                @TodayEntry.PrimaryMood
                            </MudChip>
                        </MudStack>

                        @if (!string.IsNullOrEmpty(TodayEntry.SecondaryMoods))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2"><strong>Secondary Moods:</strong></MudText>
                            <MudStack Row="true" Spacing="1">
                                @foreach (var mood in TodayEntry.SecondaryMoods.Split(','))
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@mood.Trim()</MudChip>
                                }
                            </MudStack>
                        }

                        @if (!string.IsNullOrEmpty(TodayEntry.Tags))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2"><strong>Tags:</strong></MudText>
                            <MudStack Row="true" Spacing="1">
                                @foreach (var tag in TodayEntry.Tags.Split(','))
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@tag.Trim()</MudChip>
                                }
                            </MudStack>
                        }
                    }
                </MudStack>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private EntryModel? TodayEntry;
    private string? Title;
    private string Content = string.Empty;

    private string? SelectedPrimaryMood;
    private string? SelectedMoodCategory;
    private List<string> SelectedSecondaryMoods = new();

    private List<string> PositiveMoods = EntryOptions.PositiveMoods;
    private List<string> NeutralMoods = EntryOptions.NeutralMoods;
    private List<string> NegativeMoods = EntryOptions.NegativeMoods;

    private List<string> PredefinedTags = EntryOptions.PreDefinedTags;
    private List<string> SelectedTags = new();
    private List<string> CustomTags = new();
    private string NewTag = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadTodayEntry();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await quil.InitializeAsync();
                if (TodayEntry != null && !string.IsNullOrEmpty(Content))
                {
                    await quil.SetContentAsync(Content);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error initializing editor: {ex.Message}", Severity.Error);
            }
        }
    }

    private void OnPrimaryMoodChanged(string mood)
    {
        SelectedPrimaryMood = mood;

        if (PositiveMoods.Contains(mood))
            SelectedMoodCategory = "Positive";
        else if (NeutralMoods.Contains(mood))
            SelectedMoodCategory = "Neutral";
        else if (NegativeMoods.Contains(mood))
            SelectedMoodCategory = "Negative";

        StateHasChanged();
    }

    private void ToggleTag(string tag)
    {
        if (SelectedTags.Contains(tag))
        {
            SelectedTags.Remove(tag);
        }
        else
        {
            SelectedTags.Add(tag);
        }
        StateHasChanged();
    }

    private void AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(NewTag)) return;

        var trimmedTag = NewTag.Trim();

        if (CustomTags.Contains(trimmedTag) || PredefinedTags.Contains(trimmedTag))
        {
            Snackbar.Add("Tag already exists.", Severity.Warning);
            return;
        }

        CustomTags.Add(trimmedTag);
        NewTag = string.Empty;
        Snackbar.Add($"Tag '{trimmedTag}' added!", Severity.Success);
        StateHasChanged();
    }

    private void RemoveCustomTag(string tag)
    {
        CustomTags.Remove(tag);
        StateHasChanged();
    }

    private Color GetMoodColor(string? category)
    {
        return category switch
        {
            "Positive" => Color.Success,
            "Neutral" => Color.Info,
            "Negative" => Color.Error,
            _ => Color.Default
        };
    }

    private async Task LoadTodayEntry()
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        TodayEntry = EntryService.GetTodayEntry(AuthState.CurrentUserId.Value);

        if (TodayEntry != null)
        {
            Title = TodayEntry.Title;
            Content = TodayEntry.Content;
            SelectedPrimaryMood = TodayEntry.PrimaryMood;
            SelectedMoodCategory = TodayEntry.MoodCategory;
            SelectedSecondaryMoods = EntryService.GetSecondaryMoodsList(TodayEntry);

            if (!string.IsNullOrEmpty(TodayEntry.Tags))
            {
                var allTags = TodayEntry.Tags.Split(',').Select(t => t.Trim()).ToList();
                SelectedTags = allTags.Where(t => PredefinedTags.Contains(t)).ToList();
                CustomTags = allTags.Where(t => !PredefinedTags.Contains(t)).ToList();
            }

            try { await quil.SetContentAsync(Content); } catch { }
        }
        else
        {
            Title = null;
            Content = string.Empty;
            SelectedPrimaryMood = null;
            SelectedMoodCategory = null;
            SelectedSecondaryMoods = new();
            SelectedTags = new();
            CustomTags = new();
            try { await quil.SetContentAsync(string.Empty); } catch { }
        }

        StateHasChanged();
    }

    private async Task CreateEntry()
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        try { Content = await quil.GetContentAsync(); }
        catch (Exception ex) { Snackbar.Add($"Error reading content: {ex.Message}", Severity.Error); return; }

        if (string.IsNullOrWhiteSpace(Content) || Content == "<p><br></p>")
        {
            Snackbar.Add("Content cannot be empty.", Severity.Error);
            return;
        }

        if (string.IsNullOrEmpty(SelectedPrimaryMood) || SelectedPrimaryMood == string.Empty)
        {
            Snackbar.Add("Please select a primary mood.", Severity.Warning);
            return;
        }

        if (TodayEntry != null)
        {
            Snackbar.Add("Only one entry per day allowed. Please update today's entry.", Severity.Error);
            return;
        }

        
        var allTags = SelectedTags.Concat(CustomTags).Distinct().ToList();

        var entry = new EntryModel
        {
            UserId = AuthState.CurrentUserId.Value,
            EntryDateKey = EntryService.TodayKey(),
            Title = Title,
            Content = Content,
            WordCount = EntryService.CountWords(Content),
            PrimaryMood = SelectedPrimaryMood,
            MoodCategory = SelectedMoodCategory,
            SecondaryMoods = SelectedSecondaryMoods != null && SelectedSecondaryMoods.Any()
                ? string.Join(",", SelectedSecondaryMoods)
                : null,
            Tags = allTags.Any() ? string.Join(",", allTags) : null,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };

        EntryService.SaveEntry(entry);
        TodayEntry = entry;

        Snackbar.Add("Entry saved with moods and tags!", Severity.Success);
        StateHasChanged();
    }

    private async Task UpdateEntry()
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        try { Content = await quil.GetContentAsync(); }
        catch (Exception ex) { Snackbar.Add($"Error reading content: {ex.Message}", Severity.Error); return; }

        if (string.IsNullOrWhiteSpace(Content) || Content == "<p><br></p>")
        {
            Snackbar.Add("Content cannot be empty.", Severity.Error);
            return;
        }

        if (string.IsNullOrEmpty(SelectedPrimaryMood))
        {
            Snackbar.Add("Please select a primary mood.", Severity.Warning);
            return;
        }

        
        var allTags = SelectedTags.Concat(CustomTags).Distinct().ToList();

        var entry = new EntryModel
        {
            UserId = AuthState.CurrentUserId.Value,
            EntryDateKey = EntryService.TodayKey(),
            Title = Title,
            Content = Content,
            WordCount = EntryService.CountWords(Content),
            PrimaryMood = SelectedPrimaryMood,
            MoodCategory = SelectedMoodCategory,
            SecondaryMoods = SelectedSecondaryMoods != null && SelectedSecondaryMoods.Any()
                ? string.Join(",", SelectedSecondaryMoods)
                : null,
            Tags = allTags.Any() ? string.Join(",", allTags) : null,
            UpdatedAt = DateTime.Now
        };

        EntryService.SaveEntry(entry);
        TodayEntry = entry;

        Snackbar.Add("Entry updated with moods and tags!", Severity.Success);
        StateHasChanged();
    }

    private async Task DeleteEntry()
    {
        if (!AuthState.CurrentUserId.HasValue || TodayEntry == null) return;

        EntryService.DeleteTodayEntry(AuthState.CurrentUserId.Value);
        TodayEntry = null;
        Title = null;
        Content = string.Empty;
        SelectedPrimaryMood = null;
        SelectedMoodCategory = null;
        SelectedSecondaryMoods = new();
        SelectedTags = new();
        CustomTags = new();
        await quil.SetContentAsync(string.Empty);
        Snackbar.Add("Entry deleted.", Severity.Warning);
        StateHasChanged();
    }

    private void OnSecondaryMoodsChanged(IEnumerable<string> values)
    {
        var selected = values.ToList();
        if (selected.Count > 2)
        {
            Snackbar.Add("Maximum 2 secondary moods allowed.", Severity.Info);
            return;
        }
        SelectedSecondaryMoods = selected;
        StateHasChanged();
    }
}