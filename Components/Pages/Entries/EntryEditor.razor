@page "/entry"
@using MudBlazor
@using BhawanaPatra.Models
@using BhawanaPatra.Service
@inject QuilService quil
@inject IJSRuntime js
@inject UserService UserService
@inject BhawanaPatra.Service.EntryService EntryService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (!UserService.IsLoggedIn || !UserService.CurrentUserId.HasValue)
    {
        <MudPaper Outlined="true" Class="pa-5" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:800;">
                Authentication required
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                Please login to write your journal.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/login"))">
                Go to login
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px;">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Wrap="Wrap.Wrap"
                      Spacing="2">

                <MudText Typo="Typo.subtitle1" Style="font-weight:900;">
                    New Entry - @DateTime.Now.ToString("MMMM dd, yyyy")
                </MudText>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Style="border-radius:12px;"
                           OnClick="@(() => Nav.NavigateTo("/home"))">
                    Back
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Editor Card -->
        <MudPaper Outlined="true" Class="pa-5 mt-4" Style="border-radius:16px;">
            <MudStack Spacing="3">

                <MudTextField Label="Title"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              @bind-Value="Title" />

                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:800;">
                        Content
                    </MudText>
                    <MudPaper Variant="Variant.Outlined">
                        <div id="quill-editor" style="height:300px;"></div>
                    </MudPaper>
                </MudStack>

                <!-- Actions -->
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.FlexStart">

                    @if (TodayEntry == null)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Style="border-radius:12px;"
                                   OnClick="CreateEntry">
                            Save Entry
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Style="border-radius:12px;"
                                   OnClick="UpdateEntry">
                            Update Entry
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Style="border-radius:12px;"
                               OnClick="LoadTodayEntry">
                        Reload
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Style="border-radius:12px;"
                               OnClick="DeleteEntry"
                               Disabled="@(TodayEntry == null)">
                        Delete Entry
                    </MudButton>
                </MudStack>

            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-5 mt-4" Style="border-radius:16px;">
            <MudText Typo="Typo.subtitle2" Style="font-weight:800;">
                Details
            </MudText>

            <MudDivider Class="my-3" />

            @if (TodayEntry == null)
            {
                <MudText Typo="Typo.body2" Color="Color.Inherit">
                    No entry saved yet for today.
                </MudText>
            }
            else
            {
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Created: @TodayEntry.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Updated: @TodayEntry.UpdatedAt.ToString("dd MMM yyyy, HH:mm")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Word count: @TodayEntry.WordCount
                    </MudText>
                </MudStack>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private EntryModel? TodayEntry;
    private string? Title;
    private string Content = string.Empty;

    protected override void OnInitialized()
    {
        if (!UserService.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        LoadTodayEntry();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await quil.InitializeAsync();
                if (TodayEntry != null && !string.IsNullOrEmpty(Content))
                {
                    await quil.SetContentAsync(Content);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error initializing editor: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task LoadTodayEntry()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        TodayEntry = EntryService.GetTodayEntry(UserService.CurrentUserId.Value);

        if (TodayEntry != null)
        {
            Title = TodayEntry.Title;
            Content = TodayEntry.Content;
            try
            {
                await quil.SetContentAsync(Content);
            }
            catch
            {
                // Quill might not be initialized yet, that's ok
            }
        }
        else
        {
            Title = null;
            Content = string.Empty;

            try
            {
                await quil.SetContentAsync(string.Empty);
            }
            catch
            {
                // Quill might not be initialized yet, that's ok
            }
        }

        StateHasChanged();
    }

    private async Task CreateEntry()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        // Get content from Quill editor
        try
        {
            Content = await quil.GetContentAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reading editor content: {ex.Message}", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(Content) || Content == "<p><br></p>")
        {
            Snackbar.Add("Content cannot be empty.", Severity.Error);
            return;
        }

        if (TodayEntry != null)
        {
            Snackbar.Add("Only one entry per day is allowed. Please update today's entry.", Severity.Error);
            return;
        }

        TodayEntry = EntryService.SaveTodayEntry(UserService.CurrentUserId.Value, Title, Content);
        Snackbar.Add("Entry saved.", Severity.Success);
        StateHasChanged();
    }

    private async Task UpdateEntry()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        // Get content from Quill editor
        try
        {
            Content = await quil.GetContentAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reading editor content: {ex.Message}", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(Content) || Content == "<p><br></p>")
        {
            Snackbar.Add("Content cannot be empty.", Severity.Error);
            return;
        }

        TodayEntry = EntryService.SaveTodayEntry(UserService.CurrentUserId.Value, Title, Content);
        Snackbar.Add("Entry updated.", Severity.Success);
        StateHasChanged();
    }

    private async Task DeleteEntry()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        if (TodayEntry == null)
        {
            Snackbar.Add("No entry to delete for today.", Severity.Info);
            return;
        }

        EntryService.DeleteTodayEntry(UserService.CurrentUserId.Value);

        TodayEntry = null;
        Title = null;
        Content = string.Empty;

        await quil.SetContentAsync(string.Empty);

        Snackbar.Add("Entry deleted.", Severity.Warning);
        StateHasChanged();
    }
}