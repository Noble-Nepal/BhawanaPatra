@page "/entries"
@using MudBlazor
@using BhawanaPatra.Models
@inject UserService UserService
@inject BhawanaPatra.Service.EntryService EntryService
@inject NavigationManager Nav
@inject AuthenticationStateService AuthState
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">

    @if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
    {
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:800;">
                Authentication required
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-2">
                Please login to view your entries.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/login"))">
                Go to login
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-4"
                  Wrap="Wrap.Wrap">

            <MudStack Spacing="0">
                <MudText Typo="Typo.h3" Style="font-weight:900;">
                    All Entries
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Inherit">
                    Your journal history (latest first)
                </MudText>
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Style="border-radius:12px;"
                       OnClick="@(()=>Nav.NavigateTo("/entry"))">
                Write Today
            </MudButton>
        </MudStack>

        @if (AllEntries.Count == 0)
        {
            <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
                <MudText Typo="Typo.body1" Style="font-weight:800;">
                    No entries yet.
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mt-1">
                    Start by writing your first entry.
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="mt-4"
                           Style="border-radius:12px;"
                           OnClick="@(()=>Nav.NavigateTo("/entry"))">
                    Open Editor
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var entry in AllEntries)
                {
                    <MudPaper Outlined="true" Class="pa-4" Style="border-radius:16px; cursor: pointer;" >
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                            <MudStack Spacing="1" Style="flex-grow: 1;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:800;">
                                        @FormatDate(entry.EntryDateKey)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Inherit">
                                        @entry.WordCount words
                                    </MudText>
                                </MudStack>

                                <MudText Typo="Typo.body2" Color="Color.Inherit">
                                    @(string.IsNullOrWhiteSpace(entry.Title) ? "Untitled entry" : entry.Title)
                                </MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => ShowEntryDetails(entry))" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteEntry(entry.EntryId))" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    }

</MudContainer>

@code {
    private List<EntryModel> AllEntries = new();

    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn || !AuthState.CurrentUserId.HasValue)
            return;

        var userId = AuthState.CurrentUserId.Value;
        AllEntries = EntryService.GetAllEntries(userId);
    }

    private void OpenEntry(EntryModel entry)
    {
        Nav.NavigateTo("/entry");
    }

    private async Task ShowEntryDetails(EntryModel entry)
    {
        var parameters = new DialogParameters<EntryDetailsDialog>
    {
        { x => x.Entry, entry }
    };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<EntryDetailsDialog>("Entry Details", parameters, options);
    }
    

    private void DeleteEntry(int entryId)
    {
        if (!AuthState.CurrentUserId.HasValue) return;

        EntryService.DeleteEntry(entryId);

        var userId = AuthState.CurrentUserId.Value;
        AllEntries = EntryService.GetAllEntries(userId);

        StateHasChanged();
    }

    private static string FormatDate(string dateKey)
        => DateTime.TryParse(dateKey, out var dt) ? dt.ToString("MMM dd, yyyy") : dateKey;
}