@page "/register"
@using BhawanaPatra.ViewModel
@using MudBlazor

@inject UserService UserService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center" Style="min-height:100vh;">
    <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
        <MudStack Spacing="3">

            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudAvatar Size="Size.Large" Square="false" Style="height:88px; width:88px;">
                    <img src="notes.png" alt="Logo" style="height:100%; width:100%; object-fit:contain;" />
                </MudAvatar>

                <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight:900;">
                    bhawana patra
                </MudText>

                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Inherit">
                    Create your account to begin journaling
                </MudText>
            </MudStack>

            <MudForm @ref="form" @bind-IsValid="@success">
                <MudTextField T="string"
                              Label="Username"
                              HelperText="3-8 characters"
                              @bind-Value="model.Username"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Username is required"
                              MaxLength="10"
                              Counter="8" />

                <MudTextField T="string"
                              Label="Password"
                              HelperText="Min 8 chars, 1 uppercase, 1 lowercase, 1 digit"
                              @bind-Value="model.Password"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Password is required" />

                <MudTextField T="string"
                              Label="Confirm password"
                              HelperText="Repeat the password"
                              @bind-Value="model.Password2"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Confirm password is required" />

                <MudButton OnClick="OnValidSubmit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="@isLoading"
                           Style="border-radius:12px; padding:12px 0;">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <text>Register</text>
                    }
                </MudButton>
            </MudForm>

            <MudDivider />

            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body2" Color="Color.Inherit">
                    Already have an account?
                </MudText>

                <MudLink Href="/login" Underline="Underline.Always">
                    Click here
                </MudLink>
            </MudStack>

            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                Copyright Bhawana Patra 2026
            </MudText>

        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? form;
    private bool success;
    private RegisterModel model = new();
    private bool isLoading = false;

    private async Task OnValidSubmit()
    {
        isLoading = true;
        StateHasChanged();

        await Task.Delay(100);

        var (registerSuccess, errorMessage) = UserService.RegisterUser(
            model.Username,
            model.Password,
            model.Password2
        );

        if (registerSuccess)
        {
            Snackbar.Add("Registration successful! Please login.", Severity.Success);
            await Task.Delay(200);
            Nav.NavigateTo("/login", forceLoad: true);
        }
        else
        {
            isLoading = false;
            StateHasChanged();
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }
}