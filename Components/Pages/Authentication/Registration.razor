@* @page "/" *@
@page "/register"
@using BhawanaPatra.ViewModel
@using MudBlazor

@inject UserService userService
@using System.ComponentModel.DataAnnotations

@using System.ComponentModel.DataAnnotations

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <div style="min-height: 100vh;" class="d-flex flex-column align-center justify-center">
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="7">
                <MudCard>
                    <MudCardContent>
                        <div class="d-flex justify-center mb-3">
                            <img src="notes.png" alt="Logo" style="width: 100px; height: 100px; object-fit: fill;" />
                        </div>
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">bhawana patra</MudText>
                        <MudTextField Label="First name" HelperText="Max. 8 characters"
                                      @bind-Value="model.Username" For="@(() => model.Username)"
                                      Variant="Variant.Outlined" />
                        <MudTextField Label="Password" HelperText="Choose a strong password" Class="mt-3"
                                      @bind-Value="model.Password" For="@(() => model.Password)"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined" />
                        <MudTextField Label="Password" HelperText="Repeat the password" Class="mt-3"
                                      @bind-Value="model.Password2" For="@(() => model.Password2)"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined" />
                    </MudCardContent>
                    <MudCardActions Class="px-4">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant. Filled"
                                   Color="Color.Dark"
                                   Style="background-color: #424242;"
                                   Class="register-button"
                                   FullWidth="true">
                            Register
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="7">
                <span style="color: #888;">
                   Already have an account?
                    <a style="color: #222; font-weight: 600; cursor: pointer; text-decoration: underline;"
                       @onclick="GoToLogin">
                        Click here
                    </a>
                </span>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Copy Right Bhawana Patra 2026
                </MudText>
            </MudItem>

        </MudGrid>
    </div>
</EditForm>


=

@code {
    private RegisterModel model = new();
    private bool success;

    [Inject] private UserService UserService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // This method is called when the form is submitted and passes validation.
    private void OnValidSubmit()
    {
        if (!IsPasswordStrong(model.Password))
        {
            Snackbar.Add(" Password does not meet strength requirements.", Severity.Error);
            success = false;
            return;
        }

        if (!PasswordsMatch(model.Password, model.Password2))
        {
            Snackbar.Add(" Passwords do not match.", Severity.Error);
            success = false;
            return;
        }

        var registered = UserService.RegisterUser(model.Username, model.Password);

        if (registered)
        {
            Snackbar.Add("Registration successful", Severity.Success);
            success = true;
            Nav.NavigateTo("/login");
        }
        else
        {
            Snackbar.Add(" Username already exists.", Severity.Error);
            success = false;
        }
    }

    // Checks password strength: min length, upper, lower, digit
    private bool IsPasswordStrong(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw)) return false;
        if (pw.Length < 8) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[A-Z]")) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[a-z]")) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[0-9]")) return false;
        return true;
    }

    // Checks passwords match
    private bool PasswordsMatch(string pw1, string pw2)
    {
        return pw1 == pw2;
    }
    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}