
@page "/register"
@using BhawanaPatra.ViewModel
@using MudBlazor
@using BhawanaPatra.Components.Layout
@inject UserService userService
@using System.ComponentModel.DataAnnotations




<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center" Style="min-height:100vh;">
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudStack Spacing="3">

                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Size="Size.Large" Square="false" Style="height:88px; width:88px;">
                        <img src="notes.png" alt="Logo" style="height:100%; width:100%; object-fit:contain;" />
                    </MudAvatar>

                    <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight:900;">
                        bhawana patra
                    </MudText>

                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Inherit">
                        Create your account to begin journaling
                    </MudText>
                </MudStack>

                <MudTextField Label="First name"
                              HelperText="Max. 8 characters"
                              @bind-Value="model.Username"
                              For="@(() => model.Username)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField Label="Password"
                              HelperText="Choose a strong password"
                              @bind-Value="model.Password"
                              For="@(() => model.Password)"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField Label="Confirm password"
                              HelperText="Repeat the password"
                              @bind-Value="model.Password2"
                              For="@(() => model.Password2)"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="border-radius:12px; padding:12px 0;">
                    Register
                </MudButton>

                <MudDivider />

                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Already have an account?
                    </MudText>

                    <MudLink Href="/login" Underline="Underline.Always">
                        Click here
                    </MudLink>
                </MudStack>

                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                    Copy Right Bhawana Patra 2026
                </MudText>

            </MudStack>
        </MudPaper>
    </MudContainer>
</EditForm>




@code {
    private RegisterModel model = new();
    private bool success;

    [Inject] private UserService UserService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    
    private void OnValidSubmit()
    {
        if (!IsPasswordStrong(model.Password))
        {
            Snackbar.Add(" Password does not meet strength requirements.", Severity.Error);
            success = false;
            return;
        }

        if (!PasswordsMatch(model.Password, model.Password2))
        {
            Snackbar.Add(" Passwords do not match.", Severity.Error);
            success = false;
            return;
        }

        var registered = UserService.RegisterUser(model.Username, model.Password);

        if (registered)
        {
            Snackbar.Add("Registration successful", Severity.Success);
            success = true;
            Nav.NavigateTo("/login");
        }
        else
        {
            Snackbar.Add(" Username already exists.", Severity.Error);
            success = false;
        }
    }

    // Checks password strength: min length, upper, lower, digit
    private bool IsPasswordStrong(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw)) return false;
        if (pw.Length < 8) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[A-Z]")) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[a-z]")) return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[0-9]")) return false;
        return true;
    }

    
    private bool PasswordsMatch(string pw1, string pw2)
    {
        return pw1 == pw2;
    }
    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}