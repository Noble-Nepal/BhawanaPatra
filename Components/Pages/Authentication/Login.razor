@page "/login"
@using BhawanaPatra.Components.Layout
@using BhawanaPatra.ViewModel
@using MudBlazor
@inject AuthenticationStateService AuthState

@inject UserService UserService
@inject NavigationManager Nav
@inject ISnackbar Snackbar


   

    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center" Style="min-height:100vh;">
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudStack Spacing="3">

                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Size="Size.Large" Square="false" Style="height:88px; width:88px;">
                        <img src="notes.png" alt="Logo" style="height:100%; width:100%; object-fit:contain;" />
                    </MudAvatar>

                    <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight:900;">
                        Login
                    </MudText>
                </MudStack>
                <MudForm Model="@model" OnValidSubmit="OnValidSubmit" @ref="form" @bind-IsValid="@Success" @bind-Errors="@Error">
                <MudTextField T="string"
                              Label="Username"
                              @bind-Value="model.Username"
                              For="@(() => model.Username)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Username is required" />

                <MudTextField T="string"
                              Label="Password"
                              @bind-Value="model.Password"
                              For="@(() => model.Password)"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Password is required" />


                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="border-radius:12px; padding:12px 0;">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <text>Login</text>
                    }
                </MudButton>
                </MudForm>
                <MudDivider />

                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Don&apos;t have an account?
                    </MudText>

                    <MudLink Href="/register" Underline="Underline.Always">
                        Click here
                    </MudLink>
                </MudStack>

                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                    Copy Right Bhawana Patra 2026
                </MudText>

            </MudStack>
        </MudPaper>
    </MudContainer>

@code {
    private LoginModel model = new();
    private bool isLoading = false;
    private MudForm? form;
    private bool Success;
    private String[] Error = { };

    private async Task OnValidSubmit()
    {
        isLoading = true;
        StateHasChanged();

        // Small delay for better UX (optional)
        await Task.Delay(100);

        var (success, user, errorMessage) = UserService.Login(model.Username, model.Password);

        if (success && user != null)
        {
            AuthState.Login(user);
            Snackbar.Add("Login successful!", Severity.Success);
            Nav.NavigateTo("/home");
        }
        else
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }

        isLoading = false;
        StateHasChanged();
    }
    
}
