@page "/login"
@using BhawanaPatra.Components.Layout
@using BhawanaPatra.ViewModel
@using MudBlazor


@inject UserService UserService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center" Style="min-height:100vh;">
        <MudPaper Outlined="true" Class="pa-6" Style="border-radius:16px;">
            <MudStack Spacing="3">

                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Size="Size.Large" Square="false" Style="height:88px; width:88px;">
                        <img src="notes.png" alt="Logo" style="height:100%; width:100%; object-fit:contain;" />
                    </MudAvatar>

                    <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight:900;">
                        Login
                    </MudText>
                </MudStack>

                <MudTextField Label="Username"
                              @bind-Value="model.Username"
                              For="@(() => model.Username)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true" />

                <MudTextField Label="Password"
                              @bind-Value="model.Password"
                              For="@(() => model.Password)"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="border-radius:12px; padding:12px 0;">
                    Login
                </MudButton>

                <MudDivider />

                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        Don&apos;t have an account?
                    </MudText>

                    <MudLink Href="/register" Underline="Underline.Always">
                        Click here
                    </MudLink>
                </MudStack>

                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                    Copy Right Bhawana Patra 2026
                </MudText>

            </MudStack>
        </MudPaper>
    </MudContainer>
</EditForm>

@code {
    private LoginModel model = new();

    private void OnValidSubmit()
    {
        var loggedIn = UserService.Login(model.Username, model.Password);

        if (loggedIn)
        {
            Snackbar.Add("Login successful.", Severity.Success);
            Nav.NavigateTo("/home");
        }
        else
        {
            Snackbar.Add("Invalid username or password.", Severity.Error);
        }
    }
}
