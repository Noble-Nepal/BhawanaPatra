@inherits LayoutComponentBase

@using BhawanaPatra.Components.Shared
@inject AppThemeService ThemeService
@implements IDisposable

<MudThemeProvider Theme="@MonochromeTheme"
                  IsDarkMode="@ThemeService.IsDarkMode"
                  @key="ThemeService.IsDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height:100vh; background-color: var(--mud-palette-background); color: var(--mud-palette-text-primary);">
    <Header />
    @Body
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += ThemeChanged;
    }

    private void ThemeChanged()
    {
       
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= ThemeChanged;
    }

    private static readonly MudTheme MonochromeTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Background = "#ffffff",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#111111",
            TextPrimary = "#111111",
            TextSecondary = "#555555",
            Divider = "#e5e5e5",
            LinesDefault = "#e5e5e5",
            LinesInputs = "#d0d0d0",
            Primary = "#111111",
            PrimaryContrastText = "#ffffff",
            Secondary = "#111111",
            SecondaryContrastText = "#ffffff"
        },
        PaletteDark = new PaletteDark
        {
            Background = "#0f0f0f",
            Surface = "#1b1b1b",
            AppbarBackground = "#111111",
            AppbarText = "#ffffff",
            TextPrimary = "#ffffff",
            TextSecondary = "#bdbdbd",
            Divider = "#2a2a2a",
            LinesDefault = "#2a2a2a",
            LinesInputs = "#3a3a3a",
            Primary = "#111111",
            PrimaryContrastText = "#ffffff",
            Secondary = "#111111",
            SecondaryContrastText = "#ffffff"
        }
    };
}
